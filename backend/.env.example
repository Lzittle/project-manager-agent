# OpenAI API 配置
OPENAI_API_KEY=sk-xxx-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview

# 数据库配置
DATABASE_URL=sqlite:///./project_manager.db

# ChromaDB 配置
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_docs

# 会话令牌签名密钥（轮 3 / D-030）
# 不配也能跑：用固定 demo 默认值签发令牌，启动时会打一条 [warn]。
# 生产必须覆盖 —— 否则拿到代码的人都能伪造令牌。
SECRET_KEY=change-me-to-a-long-random-secret

# 应用配置
APP_NAME=项目管理Agent
APP_HOST=0.0.0.0
APP_PORT=8000