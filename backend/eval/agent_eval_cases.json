{
  "version": 1,
  "description": "Agent 行为评测集：真实话术 → 期望的路由 / 工具 / 写库 / 回复。message 尽量照抄真实用户说法（含口语、省略主语、歧义说法）。",
  "fields": {
    "bound": "true=对话绑定夹具里的『评测主项目』；false=不绑定（project_id=null）",
    "expect.route": "期望走代码层哪条路由：conflict / ask / plan / query / agent",
    "expect.must_call_any": "每组至少命中一个工具（AND of OR）",
    "expect.must_not_call": "禁止调用的工具",
    "expect.write.mode": "none / create / update / delete / doc",
    "expect.reply_contains_any": "回复里至少出现其中一个关键词",
    "known_gap": "true=已知的现有短板（基线先记录，用来观察改没改好）",
    "repeat": "整条用例重复发送的次数，用于测幂等"
  },
  "cases": [
    {
      "id": "q01_progress_whats_up",
      "category": "查询",
      "bound": true,
      "message": "项目现在什么情况",
      "expect": {
        "route": ["query"],
        "must_call_any": [["project_snapshot", "list_tasks"]],
        "must_not_call": ["create_task", "plan_tasks", "delete_task", "update_task_status", "update_task_fields", "save_meeting"],
        "write": {"mode": "none"},
        "reply_contains_any": ["6", "六"]
      },
      "known_gap": false,
      "note": "「什么情况」纳入只读查询路由：代码层先注入真实任务快照再作答"
    },
    {
      "id": "q02_progress_how",
      "category": "查询",
